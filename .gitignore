# ============================================
# .gitignore — プロジェクト全体
# 【D管理】
# ============================================

# --- Node ---
node_modules/
dist/
dist-ssr/
*.local

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Environment ---
.env
.env.local
.env.*.local

# --- IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- Build ---
build/
*.tsbuildinfo
